# Use Linux binaries compiled with the pinned Go image and verified local cache.
FROM order-transaction:frontend-only AS frontend
FROM alpine:3.20
WORKDIR /app
RUN apk add --no-cache tzdata ca-certificates && adduser -D -u 10001 appuser \
 && mkdir -p /app/data /app/logs && chown -R appuser:appuser /app/data /app/logs
COPY deploy/local-bin/ /app/
COPY configs/ /app/configs/
COPY web/index.html /app/web/index.html
COPY --from=frontend /src/web/dist/ /app/web/dist/
USER appuser
EXPOSE 8080
CMD ["/app/gateway"]
